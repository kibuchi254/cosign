# Copy to agent/.env (git-ignored) for local runs. Real environment variables win over this file.
# The agent never gets PayPal credentials.

CORE_URL=http://localhost:8080
CORE_AGENT_TOKEN=local-agent-token-change-me

# replay (default, no key) | live (call the model) | offline (deterministic reader only)
COSIGN_LLM_MODE=live
COSIGN_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Any OpenRouter model id. Default: z-ai/glm-5.2
COSIGN_LLM_MODEL=z-ai/glm-5.2
# off (default): a failed model call makes the document UNREADABLE, so it is never paid.
# offline: fall back to the deterministic reader instead (labelled in the UI).
COSIGN_LLM_FALLBACK=off
