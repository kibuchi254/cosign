            ],
            "url": {
              "raw": "{{core}}/v1/proposals",
              "host": [
                "{{core}}"
              ],
              "path": [
                "v1",
                "proposals"
              ]
            },
            "description": "Submit an invoice payment proposal; returns the decision (ALLOW is paid at once)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoice\": {\n    \"vendor_name\": \"Fabrikam Freight\",\n    \"invoice_number\": \"FF-{{$randomInt}}\",\n    \"amount\": \"850.00\",\n    \"currency\": \"USD\",\n    \"due_date\": \"2026-12-01\",\n    \"payout_email\": \"ap@fabrikam.example\",\n    \"source_hash\": \"sha256:postman\",\n    \"extracted\": {}\n  },\n  \"flags\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json(); pm.collectionVariables.set('payment_id', j.payment_id); pm.collectionVariables.set('decision_hash', j.decision_hash);",
                  "pm.test('decided', ()=> pm.expect(['ALLOW','REQUIRE_APPROVAL','BLOCK']).to.include(j.decision));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /v1/approvals/{payment_id}",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
