{
  "info": {
    "name": "Cosign core API",
    "description": "Every endpoint of the Cosign Rust core, generated from core/openapi.json. Run top to bottom against a seeded core (docker compose): it creates a mandate and vendor, submits an invoice, approves it, runs a milestone from funding to release, and verifies the audit chain. Webhooks need real PayPal signatures, so that request is expected to be refused.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "GET /healthz",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{core}}/healthz",
              "host": [
                "{{core}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "Health and PayPal mode"
          }
        }
      ]
    },
