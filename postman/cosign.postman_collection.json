            "url": {
              "raw": "{{core}}/v1/approvals/{{payment_id}}",
              "host": [
                "{{core}}"
              ],
              "path": [
                "v1",
                "approvals",
                "{{payment_id}}"
              ]
            },
            "description": "Approve or deny a payment that needs approval (must quote decision_hash)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verdict\": \"approve\",\n  \"approver\": \"Postman\",\n  \"decision_hash\": \"{{decision_hash}}\",\n  \"note\": \"checked by phone\"\n}",
              "options": {
