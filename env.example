# PayPal Sandbox credentials, can be obtained from developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Optional: AG Studio licence key for /dashboard.
AG_STUDIO=

# Optional: the AG Studio AI assistant on /dashboard. If blank, an OPENAI_API_KEY already in
# your environment is used instead; with neither, the assistant is hidden.
AG_STUDIO_OPENAI_API_KEY=

# Comma-separated OpenAI model ids for the assistant's model picker; the first is the default.
# If blank, gpt-5.4-mini is used as the default, and no model switcher options are available.
OPENAI_MODELS=gpt-5.6-terra,gpt-5.6-luna,gpt-5.6-sol

# --- Cosign services (core/, agent/). Only the Rust core reads PAYPAL_*. ---------------
# Webhook ID from the developer dashboard (Apps & Credentials > your app > Webhooks).
PAYPAL_WEBHOOK_ID=
# Shared bearer tokens between services; must differ, 16+ characters.
CORE_AGENT_TOKEN=local-agent-token-change-me
CORE_OPERATOR_TOKEN=local-operator-token-change-me
CORE_URL=http://localhost:8080
# replay (default) | live | offline. live needs ANTHROPIC_API_KEY (or COSIGN_LLM_PROVIDER=openai).
COSIGN_LLM_MODE=replay
ANTHROPIC_API_KEY=

# --- Web app (Next.js). Talks to the core and agent server-side only. --------------------------
COSIGN_CORE_URL=http://localhost:8080
COSIGN_AGENT_URL=http://localhost:8000
# Demo login for /console. Required in production; defaults to "cosign" in development.
DEMO_PASSWORD=cosign
# Signs the session cookie; 16+ characters. Required in production.
SESSION_SECRET=
# Optional third token for scheduled jobs (/internal/reauthorize).
CORE_INTERNAL_TOKEN=local-internal-token-change-me
