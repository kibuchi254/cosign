# Cosign environment. Copy to .env (git-ignored) for local runs, or paste the values into
# Dokploy's Environment tab (see deploy/DOKPLOY.md). Never commit real values.
#
# Generate every secret with:  openssl rand -hex 24
# The three CORE_*_TOKEN values must all be different and at least 16 characters.

# --- Public address -----------------------------------------------------------------------------
# The one domain the whole app is served on (no trailing slash). Used for PayPal return links and
# to identify the app to OpenRouter.
COSIGN_PUBLIC_URL=https://cosign.digikenya.co.ke

# --- Database (Postgres) -------------------------------------------------------------------------
# Dokploy / docker-compose.dokploy.yml: set only POSTGRES_PASSWORD (hex only: it goes into a URL).
# The compose file builds DATABASE_URL for the core from it.
POSTGRES_PASSWORD=change-me-to-a-long-hex-string
# Local runs of the core without Docker read DATABASE_URL directly.
DATABASE_URL=postgres://cosign:cosign@localhost:5432/cosign

# --- Service tokens (shared between core, agent, web and the job runner) -------------------------
CORE_AGENT_TOKEN=local-agent-token-change-me
CORE_OPERATOR_TOKEN=local-operator-token-change-me
CORE_INTERNAL_TOKEN=local-internal-token-change-me

# --- Web app (Next.js). Talks to the core and agent server-side only. -----------------------------
# Password for signing in to /console. Required in production; defaults to "cosign" in development.
DEMO_PASSWORD=cosign
# Signs the login cookie; 16+ characters. Required in production.
SESSION_SECRET=
# Where the web app finds the other services. The Dokploy compose file sets these for you.
COSIGN_CORE_URL=http://localhost:8080
COSIGN_AGENT_URL=http://localhost:8000

# --- AI invoice reading (Python agent) -------------------------------------------------------------
# live: read invoices with the model below (needs a key)
# offline: deterministic reader only, no key, no cost
# replay: replays recorded model answers for the demo samples (local demos only)
COSIGN_LLM_MODE=live
COSIGN_LLM_PROVIDER=openrouter
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model id. Default: z-ai/glm-5.2
COSIGN_LLM_MODEL=z-ai/glm-5.2
# off (default): if the model call fails, the invoice is UNREADABLE and is never paid.
# offline: fall back to the deterministic reader instead (labelled in the UI).
COSIGN_LLM_FALLBACK=off
# Only if you switch COSIGN_LLM_PROVIDER to anthropic or openai.
ANTHROPIC_API_KEY=
# Local runs of the agent find the core here (the compose files set it for you).
CORE_URL=http://localhost:8080

# --- PayPal (only the Rust core reads these) --------------------------------------------------------
# Sandbox REST app from developer.paypal.com. Leave blank to simulate payouts.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Webhook ID (Apps & Credentials > your app > Webhooks). Point the webhook at
# https://cosign.digikenya.co.ke/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# --- Optional ---------------------------------------------------------------------------------------
# Dokploy: set to "demo" for one deploy to load the demo mandate and three fictional vendors.
COMPOSE_PROFILES=
# AG Studio licence key for /dashboard.
AG_STUDIO=
# The AG Studio AI assistant on /dashboard. If blank, an OPENAI_API_KEY already in your
# environment is used instead; with neither, the assistant is hidden.
AG_STUDIO_OPENAI_API_KEY=
# Comma-separated OpenAI model ids for the assistant's model picker; the first is the default.
OPENAI_MODELS=gpt-5.6-terra,gpt-5.6-luna,gpt-5.6-sol
