{
  "openapi": "3.1.0",
  "info": {
    "title": "Cosign core API",
    "version": "0.2.0",
    "description": "The Rust core: decides, records and moves money. The AI proposes; this API decides. Tokens: agent (proposals and criteria results only), operator (the web app), internal (scheduled jobs)."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health and PayPal mode",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "paypal": {
                      "type": "string",
                      "enum": [
                        "live",
                        "simulated"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/proposals": {
      "post": {
        "summary": "Submit an invoice payment proposal; returns the decision (ALLOW is paid at once)",
        "tags": [
          "payments"
        ],
        "responses": {
          "201": {
            "description": "Decided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        },
        "security": [
          {
            "agent": []
          },
          {
            "operator": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposalInput"
              }
            }
          }
        }
      }
    },
    "/v1/approvals/{payment_id}": {
      "post": {
        "summary": "Approve or deny a payment that needs approval (must quote decision_hash)",
        "tags": [
          "payments"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalResponse"
